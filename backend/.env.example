# Copy this file to .env only after Django is initialized.
# Never commit the resulting .env file.

DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=willchain
POSTGRES_USER=willchain_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google Identity Services: use the same OAuth web client ID on frontend and backend.
GOOGLE_OAUTH2_CLIENT_ID=your-google-oauth-web-client-id
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For release email demonstrations, configure SMTP in backend/.env and never commit credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-sender@gmail.com
# EMAIL_HOST_PASSWORD=your-provider-app-password
# DEFAULT_FROM_EMAIL=WillChain SL <your-sender@gmail.com>
